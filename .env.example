# Copy to .env and fill in your Neon Postgres credentials.
# .env is gitignored - never commit the real values.
#
# Run with `./mvnw spring-boot:run -Dspring-boot.run.profiles=prod` - it reads .env
# automatically via spring.config.import in application-prod.properties.
#
# Get these from the Neon console -> your project -> Connection Details. Use the
# *unpooled* connection string (no "-pooler" in the hostname) - HikariCP already pools
# connections on this side, so stacking Neon's own PgBouncer pooler on top of it can
# cause issues with Hibernate's prepared-statement caching.

DB_URL=jdbc:postgresql://<endpoint>.neon.tech/<database>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# Must match petManagementService's JWT_SECRET exactly - Core verifies tokens this
# service issues using the same shared HMAC secret.
JWT_SECRET=
JWT_EXPIRATION=86400000
